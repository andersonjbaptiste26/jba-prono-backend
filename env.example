# ================================
# JBa Prono — Variables d'environnement
# ================================
# Copier ce fichier en .env et remplir les valeurs.
# En production (Render/Railway), ces variables se configurent
# dans l'interface du service — ce fichier sert de référence.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ADMIN_TOKEN=change-me-please-generate-with-openssl-rand-hex-32
ODDS_API_KEY=
FOOTBALL_DATA_API_KEY=
